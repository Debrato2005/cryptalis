  "script": "import cProfile\nimport hashlib\nimport json\nfrom pathlib import Path\nimport platform\nimport pstats\nimport time\nfrom uuid import UUID\n\nfrom test_cf1 import descriptor, setup_keys, TENANT\nfrom cryptalis.crypto.cf1 import seal_text, open_text\n\nROOT = Path('/home/debrato/Projects/cryptalis')\nhashes = {str(p.relative_to(ROOT)): hashlib.sha256(p.read_bytes()).hexdigest()\n          for p in (ROOT/'src/cryptalis').rglob('*.py')}\nresults = []\nfor width, n in ((53, 10000), (32768, 1000)):\n    field = descriptor(equality=True)\n    _, ring = setup_keys(equality=True)\n    keys = ring.prepare()\n    value = 'x' * width\n    records = [UUID(int=i+10) for i in range(n)]\n    start = time.perf_counter(); cpu = time.thread_time()\n    frames = [seal_text(value, field, TENANT, record, keys) for record in records]\n    seal = {'seconds': time.perf_counter()-start, 'cpu_seconds': time.thread_time()-cpu}\n    start = time.perf_counter(); cpu = time.thread_time()\n    for frame, record in zip(frames, records):\n        assert open_text(frame, field, TENANT, record, keys) == value\n    opened = {'seconds': time.perf_counter()-start, 'cpu_seconds': time.thread_time()-cpu}\n    profiles = {}\n    for name in ('seal', 'open'):\n        profile = cProfile.Profile(); profile.enable()\n        for record, frame in zip(records, frames):\n            if name == 'seal': seal_text(value, field, TENANT, record, keys)\n            else: assert open_text(frame, field, TENANT, record, keys) == value\n        profile.disable(); stats = pstats.Stats(profile)\n        calls = [{'file': Path(path).name, 'name': fn, 'calls': count, 'exclusive_s': own, 'cumulative_s': total}\n                 for (path, line, fn), (_, count, own, total, _) in stats.stats.items()]\n        profiles[name] = {'total_profiled_seconds': stats.total_tt,\n                         'calls': sorted(calls, key=lambda c:c['cumulative_s'], reverse=True)[:25]}\n    results.append({'encoded_bytes': width, 'values': n, 'seal': seal, 'open': opened, 'profiles': profiles})\nrevision = hashlib.sha256(json.dumps(hashes, sort_keys=True).encode()).hexdigest()[:16]\nreceipt = {'scope': 'Single-process warm CF1 CPU research; public fixture roots; no database',\n    'source_sha256': hashes, 'measurements': results, 'python': platform.python_version(),\n    'script': Path(__file__).read_text(),\n    'limitations': ['Current code only; no crypto change or comparative improvement.',\n                   'cProfile cumulative calls overlap; profiled timings include instrumentation.',\n                   'Roundtrip assertions are measurement controls; frozen vectors provide separate correctness evidence.',\n                   'Thread/process scaling, remote providers and production workloads remain unmeasured.'],\n    'qualification': 'All seven gates UNKNOWN'}\nwith (ROOT/'docs/_reset'/f'performance-crypto-cost-{revision}.json').open('x') as f:\n    f.write(json.dumps(receipt, indent=2)+'\\n')\nprint(json.dumps([{k:v for k,v in r.items() if k!='profiles'} for r in results]))\n",
